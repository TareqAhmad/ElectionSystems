@{
    ViewData["Title"] = "صندوق اقتراع أعضاء الهيئة الإدارية - نظام إجماع";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/Voters/VoterBallot2.css" />
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-ejmaa">انتخابات أعضاء الهيئة الإدارية</h1>
        <p class="text-muted fs-5">نظام إجماع الإلكتروني - الدورة البرامجية</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10 col-md-12">
            <div class="card shadow-sm p-4 p-md-5 border-0 rounded-4">

                <div class="step-content fade-in" id="stepBallot">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <div>
                            <h3 class="fw-bold text-dark m-0">قائمة المرشحين</h3>
                            <span class="text-muted fs-7">يرجى تحديد خياراتك بالنقر المباشر على بطاقة المرشح</span>
                        </div>
                        <div class="badge bg-primary px-3 py-2 fs-6">
                            الحد الأقصى للاختيار: <span id="maxLimit">0</span> مرشحين
                        </div>
                    </div>

                    <div class="row g-4 mb-5" id="membersList">

                        <!-- سيتم ملء هذه المنطقة بالمرشحين عبر JavaScript -->
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <div class="fs-5 text-dark">
                            تم اختيار: <strong id="selectedCount" class="text-primary">0</strong> من أصل <strong
                            id="maxAllowed">7</strong>
                        </div>
                        <button type="button" onclick="goToSummary()" class="btn btn-success btn-lg px-5 shadow-sm">
                            الانتقال لملخص ورقة الاقتراع <i class="bi bi-arrow-left ms-2"></i>
                        </button>
                    </div>
                </div>

                <div class="step-content d-none fade-in" id="stepSummary">
                    <div class="text-center mb-4">
                        <i class="bi bi-clipboard-check text-warning mb-3" style="font-size: 3rem;"></i>
                        <h2 class="fw-bold text-dark">تأكيد خياراتك الانتخابية</h2>
                        <p class="text-muted">الرجاء مراجعة الأسماء أدناه بعناية قبل الإرسال النهائي</p>
                    </div>

                    <div class="row justify-content-center mb-4">
                        <div class="col-md-8">
                            <div class="p-4 rounded-3 bg-light border-start border-success border-4 shadow-sm">
                                <span class="text-muted d-block fs-7 mb-2">المرشحون المختارون لعضوية الهيئة
                                    الإدارية:</span>
                                    <ul class="list-unstyled fw-bold text-dark fs-5 mb-0" id="selectedMembersSummary">
                                        <li class="text-danger">• لم يتم اختيار أي مرشح بعد</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-center">
                            <button type="button" onclick="submitFinalVote()" class="btn btn-success btn-lg px-5 shadow">
                                إرسال الصوت نهائياً <i class="bi bi-check2-square ms-2"></i>
                            </button>
                            <button type="button" onclick="backToBallot()" class="btn btn-outline-secondary btn-lg px-4">
                                تعديل الخيارات <i class="bi bi-pencil-square ms-2"></i>
                            </button>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="~/JS/apiService.js"></script>
        <script src="~/JS/Voters/VoterBallot2.js"></script>
    }