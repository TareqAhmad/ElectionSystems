@using Microsoft.AspNetCore.Identity
@model IEnumerable<Ejmmaa.Models.ViewModels.VotersViewModel>;

@{
    ViewData["Title"] = "إدارة الناخبين - إجماع";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/SuperAdmin/dashboard.css" />
    <link rel="stylesheet" href="~/css/Admins/Manage.css" />
}

<div class="dashboard-wrapper-layout">
    <aside class="sidebar-wrapper">
        <div class="sidebar-header">
            <h4 class="text-gold fw-bold">ادارة العملية الانتخابية</h4>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Elections")" class="nav-item"><i class="bi bi-speedometer2"></i> لوحة
                التحكم</a>
                <a href="@Url.Action("Index", "Candidates")" class="nav-item"><i class="bi bi-gear"></i> المرشحين</a>
                <a href="@Url.Action("Show", "Voters")" class="nav-item active"><i class="bi bi-people"></i> الناخبين</a>
                <a href="@Url.Action("Manage" , "Supervisors")" class="nav-item"><i class="bi bi-gear"></i> المشرفين</a>
                <a href="@Url.Action("Index","Regions")" class="nav-item"><i class="bi bi-people"></i>المناطق</a>
                <a href="@Url.Action("Index","PollingStations")" class="nav-item"><i class="bi bi-geo-alt"></i> مراكز
                    الاقتراع</a>
                    <a href="@Url.Action("Index","BallotBoxes")" class="nav-item"><i class="bi bi-box"></i> الصناديق</a>
                    <div class="nav-divider"></div>
                    <a href="@Context.Request.Headers["Referer"]" class="nav-item text-danger"><i
                        class="bi bi-box-arrow-right"></i> عودة</a>

                    </nav>
                </aside>
                <main class="main-content-dashboard">
                    <header class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold">الناخبين</h2>
                            <p class="text-muted">استعراض وإدارة الناخبين المؤهلين للاقتراع في العشيرة</p>
                        </div>
                    </header>

                    <div class="row g-4">
                        <div class="col-12">
                            <div class="card p-4 shadow-sm border-0">
                                <div class="table-responsive">
                                    <table id="votersTable" class="table ejmaa-table w-100 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>#</th>
                                                <th>الاسم الكامل</th>
                                                <th>الرقم الوطني</th>
                                                <th>رقم الهاتف</th>
                                                <th>تاريخ الميلاد</th>
                                                <th>الجنس</th>
                                                <th>الإجراءات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var voter in Model)
                                            {
                                                <tr>
                                                    <td>@voter.MemberId</td>
                                                    <td>@voter.FullName</td>
                                                    <td>@voter.NationalId</td>
                                                    <td>@voter.PhoneNumber</td>
                                                    <td>@voter.BirthDate</td>
                                                    <td>@(voter.Gender == 'M' ? "ذكر" : "انثى" )</td>
                                                    <td>
                                                        <a class="btn btn-sm btn-warning"
                                                           href="@Url.Action("Edit", "Voters", new { voterId = voter.MemberId })">تعديل</a>
                                                        <a class="btn btn-sm btn-danger"
                                                           href="@Url.Action("Delete", "Voters", new { voterId = voter.MemberId })">حذف</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>

            @section Scripts {
                <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
                <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
                <script src="~/JS/Voters/Index.js"></script>
            }