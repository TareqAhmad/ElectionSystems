@model Ejmmaa.Models.ViewModels.CandidatesViewModel;


@{
    ViewData["Title"] = "حذف المرشح - إجماع";
}

@section Styles {
    <link rel="stylesheet" href="~/css/SuperAdmin/dashboard.css" />
    <link rel="stylesheet" href="~/css/Candidates/Delete.css" />
}

<div class="dashboard-wrapper-layout">
    <aside class="sidebar-wrapper">
        <div class="sidebar-header">
            <h4 class="text-gold fw-bold">ادارة العملية الانتخابية</h4>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Elections")" class="nav-item"><i class="bi bi-speedometer2"></i> لوحة
                التحكم</a>
                <a href="@Url.Action("Index","Candidates")" class="nav-item active"><i class="bi bi-gear"></i> المرشحين</a>
                <a href="@Url.Action("Show", "Voters")" class="nav-item"><i class="bi bi-people"></i> الناخبين</a>
                <a href="@Url.Action("Manage" , "Supervisors")" class="nav-item"><i class="bi bi-gear"></i> المشرفين</a>
                <a href="@Url.Action("Index", "PollingStations")" class="nav-item"><i class="bi bi-geo-alt"></i> مراكز
                    الاقتراع</a>
                    <a href="@Url.Action("Index","BallotBoxes")" class="nav-item"><i class="bi bi-box"></i> الصناديق</a>
                    <div class="nav-divider"></div>
                    <a href="@Context.Request.Headers["Referer"]" class="nav-item text-danger"><i
                        class="bi bi-box-arrow-right"></i> عودة</a>
                    </nav>
                </aside>

                <main class="main-content-dashboard">
                    <header class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold">حذف المرشح</h2>
                            <p class="text-muted">استعراض وإدارة العملية الانتخابية</p>
                        </div>
                    </header>

                    <div class="row g-4">
                        <div class="col-12">
                            <form id="deleteCandidateForm" class="mt-3 border rounded p-4 bg-white shadow-sm">
                                <div class="row">
                                    <div class="col-md mb-3">
                                        <input type="hidden" id="CandidateId" value="@Model.CandidateId" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md mb-3">
                                        <label for="ElectionSelect" class="form-label fw-bold">العملية الانتخابية</label>
                                        <select class="form-select fs-4" id="ElectionSelect" name="ElectionId" required>
                                            <option value="@Model.ElectionId">@Model.ElectionTitle</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md mb-3">
                                        <label for="NationalId" class="form-label fw-bold">الرقم الوطني</label>
                                        <input type="text" class="form-control fs-4" id="NationalId" name="NationalId" required
                                               value="@Model.NationalId">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">صورة المرشح</label>
                                    <div class="d-flex align-items-center gap-3 border p-2 rounded bg-light">
                                        <input type="hidden" id="iconId" name="iconId" value="">

                                        <div id="selectedIconPreview"
                                             class="p-2 bg-white rounded border d-flex align-items-center justify-content-center"
                                             style="width: 60px; height: 60px;">
                                            <i class="fas fa-box fa-2x text-muted"></i>
                                        </div>

                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal"
                                                data-bs-target="#iconPickerModal">
                                            <i class="fas fa-images me-1"></i> اختر صورة المرشح...
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <button type="submit" class="btn btn-danger fs-4 px-4"><i
                                        class="fas fa-save me-2"></i>حذف</button>
                                        <a href="@Url.Action("Index", "Candidates")" class="btn btn-secondary fs-4 px-4">إلغاء</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </main>
                </div>

                @section Scripts {
                    <script src="~/JS/apiService.js"></script>
                    <script src="~/JS/Candidates/Delete.js"></script>
                }