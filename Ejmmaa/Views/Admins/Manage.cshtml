@model Ejmmaa.Models.ViewModels.AdminViewModels;


@{
    ViewData["Title"] = "إدارة العشيرة الداخلية - إجماع";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/SuperAdmin/dashboard.css" />
    <link rel="stylesheet" href="~/css/Admins/Manage.css" />
}

<div class="dashboard-wrapper-layout">
    <aside class="sidebar-wrapper">
        <div class="sidebar-header"><h4 class="text-gold fw-bold">لجنة العشيرة</h4></div>
        <nav class="sidebar-nav">
            <a href="#" class="nav-item active"><i class="bi bi-speedometer2"></i> لوحة التحكم</a>
            <a href="@Url.Action("Index","Sections")" class="nav-item"><i class="bi bi-diagram-3"></i>الاقسام</a>
            <a href="@Url.Action("Index","Members")" class="nav-item"><i class="bi bi-people"></i>الأفراد</a>
            <a href="@Url.Action("Index","Elections")" class="nav-item"><i class="bi bi-gear"></i> ادارة العملية الانتخابية</a>
           <div class="nav-divider"></div>
           <a href="/" class="nav-item text-danger"><i class="bi bi-box-arrow-right"></i> تسجيل الخروج</a>
        </nav>
    </aside>

    <main class="main-content-dashboard">
        <header class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">لوحة إدارة الهيئة العامة</h2>
            <a href="@Url.Action("Create","Elections")" class="btn btn-gold">
                <i class="bi bi-plus-lg"></i> اضافـــة
            </a>
        </header>

        <div class="row g-4">
            <div class="col-12">
                <div class="card p-3 shadow-sm">
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle"></i> معلومات العشيرة</h5>
                    <table id="ClanInfoTable" class="table ejmaa-table w-100">
                        <thead class="table-light">
                            <tr>
                                <th>رمز العشيرة</th>
                                <th>الاسم</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var clan in Model.Clans)
                            {
                                <tr>
                                    <td>@clan.ClanId</td>
                                    <td>@clan.ClanName</td>
                                    <td><span class="badge bg-success">نشط</span></td>
                                    <td>
                                    <button class="btn btn-sm btn-warning" onclick="editClan(@clan.ClanId)">تعديل</button>
                                    <button  class="btn btn-sm btn-danger" onclick="deleteClan(@clan.ClanId)">حذف</button>
                                    </td>                       
                                 </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-12">
                <div class="card p-3 shadow-sm">
                    <h5 class="fw-bold mb-3"><i class="bi bi-diagram-3"></i> أقسام العشيرة</h5>
                    <table id="SectionsTable" class="table ejmaa-table w-100">
                        <thead class="table-light">
                            <tr>
                                <th>CheckBox</th>
                                <th>القسم</th>
                                <th>عدد الأفراد</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="x"> @*ClanSectionsBody*@
                            @foreach (var sec in  Model.Sections)
                            {
                                <tr>
                                    <td><input type="checkbox" class="section-checkbox" value="@sec.SectionId" /></td>
                                    <td>@sec.SectionName</td>
                                    <td>@sec.MemberCount</td>
                                    <td>
                                        <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", "Sections", new { sectionId = sec.SectionId })">تعديل</a>
                                        <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", "Sections", new { sectionId = sec.SectionId })">حذف</a>
                                    </td>                       
                                 </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-12">
                <div class="content-card p-3 shadow-sm">
                    <h5 class="fw-bold mb-3"><i class="bi bi-people"></i> جدول الأفراد</h5>
                    <table id="membersTable" class="table ejmaa-table w-100">
                        <thead class="table-light">
                            <tr>
                                <th>الاسم الكامل</th>
                                <th>الرقم الوطني</th>
                                <th>رقم الهاتف</th>
                                <th>تاريخ الميلاد</th>
                                <th>الجنس</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="m"> @*membersTableBody*@
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td>@member.FullName</td>
                                    <td>@member.NationalId</td>
                                    <td>@member.PhoneNumber</td>
                                    <td>@member.BirthDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(member.Gender == 'M' ? "ذكر" : "أنثى")</td>
                                    <td>    
                                        <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", "Members", new { memberId = member.MemberId })">تعديل</a>
                                        <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", "Members", new { memberId = member.MemberId })">حذف</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/JS/apiService.js"></script>
    <script src="~/JS/Admins/Manage.js"></script>
}



<div class="modal fade" id="AddOptionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-custom text-white d-flex justify-content-between align-items-center w-100" dir="rtl">
                <h5 class="modal-title m-0">خيارات الاضافة</h5>
                <button type="button" class="btn-close btn-close-white m-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <!-- خيار إنهاء الشفت -->
                    <div class="col-6">
                        <a id="btnAddSection" href="@Url.Action("Create","Sections")" class="btn btn-outline-success w-100 p-3 fs-5 fw-bold">
                            <i class="bi bi-clock-history d-block mb-2"></i>
                                 اضافة اقسام للعشيرة 
                         </a>
                    </div>
                    <!-- خيار المغادرة -->
                    <div class="col-6">
                        <a id="btnAddMember" href="@Url.Action("Create","Members")" class="btn btn-outline-primary w-100 p-3 fs-5 fw-bold">
                            <i class="bi bi-door-open d-block mb-2"></i>
                               اضافة افراد للعشيرة
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>