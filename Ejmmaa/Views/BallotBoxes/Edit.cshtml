@{
    ViewData["Title"] = "تعديل مراكز الاقتراع - إجماع";
}

@section Styles {
    <link rel="stylesheet" href="~/css/SuperAdmin/dashboard.css" />
    <link rel="stylesheet" href="~/css/BallotBoxes/Edit.css" />
}

<div class="dashboard-wrapper-layout">
    <aside class="sidebar-wrapper">
        <div class="sidebar-header">
            <h4 class="text-gold fw-bold">ادارة العملية الانتخابية</h4>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "Elections")" class="nav-item"><i class="bi bi-speedometer2"></i> لوحة
                التحكم</a>
                <a href="@Url.Action("Index","Candidates")" class="nav-item"><i class="bi bi-gear"></i> المرشحين</a>
                <a href="@Url.Action("Show", "Voters")" class="nav-item"><i class="bi bi-people"></i> الناخبين</a>
                <a href="@Url.Action("Manage" , "Supervisors")" class="nav-item"><i class="bi bi-gear"></i> المشرفين</a>
                <a href="@Url.Action("Index","Regions")" class="nav-item"><i class="bi bi-people"></i>المناطق</a>
                <a href="@Url.Action("Index", "PollingStations")" class="nav-item"><i class="bi bi-geo-alt"></i> مراكز
                    الاقتراع</a>
                    <a href="@Url.Action("Index","BallotBoxes")" class="nav-item active"><i class="bi bi-box"></i> الصناديق</a>
                    <div class="nav-divider"></div>
                    <a href="@Context.Request.Headers["Referer"]" class="nav-item text-danger"><i
                        class="bi bi-box-arrow-right"></i> عودة</a>
                    </nav>
                </aside>

                <main class="main-content-dashboard">
                    <header class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold">تعديل صناديق الاقتراع </h2>
                            <p class="text-muted">استعراض وإدارة العملية الانتخابية</p>
                        </div>
                    </header>

                    <div class="row g-4">
                        <div class="col-12">
                            <form id="createBallotBoxForm" class="mt-3 border rounded p-4 bg-white shadow-sm">
                                <div class="row">
                                    <div class="col-md mb-3">
                                        <label for="StationSelect" class="form-label fw-bold">مركز الاقتراع</label>
                                        <select class="form-select fs-4" id="StationSelect" name="StationSelect" required>
                                            <option value="">اختر المركز</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md mb-3">
                                        <label for="BoxNumber" class="form-label fw-bold">رقم الصندوق</label>
                                        <input type="text" class="form-control fs-4" id="BoxNumber" name="BoxNumber" required>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <button type="submit" class="btn btn-success fs-4 px-4"><i
                                        class="fas fa-save me-2"></i>حفظ</button>
                                        <a href="@Url.Action("Index", "BallotBoxes")" class="btn btn-secondary fs-4 px-4">إلغاء</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </main>
                </div>

                @section Scripts {
                    <script src="~/JS/apiService.js"></script>
                    <script src="~/JS/BallotBoxes/Edit.js"></script>
                }