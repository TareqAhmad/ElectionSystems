@model Ejmmaa.Models.ViewModels.ClanMembersViewModel


@{
    ViewData["Title"] = "حذف فرد - إجماع";
}

@section Styles {
    <link rel="stylesheet" href="~/css/SuperAdmin/dashboard.css" />
    <link rel="stylesheet" href="~/css/Members/Delete.css" />
}

<div class="dashboard-wrapper-layout">
    <aside class="sidebar-wrapper">
        <div class="sidebar-header">
            <h4 class="text-gold fw-bold">لجنة العشيرة</h4>
        </div>
        <nav class="sidebar-nav">
            <a href="#" class="nav-item"><i class="bi bi-speedometer2"></i> لوحة التحكم</a>
            <a href="@Url.Action("Index","Sections")" class="nav-item"><i class="bi bi-diagram-3"></i>الاقسام</a>
            <a href="@Url.Action("Index","Members")" class="nav-item active"><i class="bi bi-people"></i>الأفراد</a>
            <a href="@Url.Action("Index","Elections")" class="nav-item"><i class="bi bi-gear"></i> ادارة العملية
                الانتخابية</a>
                <div class="nav-divider"></div>
                <a href="/" class="nav-item text-danger"><i class="bi bi-box-arrow-right"></i> تسجيل الخروج</a>
            </nav>
        </aside>

        <main class="main-content-dashboard">
            <header class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold">حذف فرد</h2>
                    <p class="text-muted">استعراض وإدارة العملية الانتخابية</p>
                </div>
            </header>

            <div class="row g-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white py-3"></div>
                        <div class="card-body p-4">
                            <form id="deleteMemberForm" class="mt-3 border rounded p-4 bg-white shadow-sm">
                                <div class="row g-3">
                                    <div class="row-md-6">
                                        <input type="hidden" id="memberId" name="memberId" value="@Model.MemberId" />
                                    </div>
                                    <div class="row-md-6">
                                        <label class="form-label">الاسم الكامل</label>
                                        <input type="text" class="form-control" name="fullName" id="fullName" required
                                               value="@Model.FullName">
                                    </div>
                                    <div class="row-md-6">
                                        <label class="form-label">الرقم الوطني</label>
                                        <input type="text" class="form-control" name="nationalId" id="nationalId" required
                                               value="@Model.NationalId">
                                    </div>
                                    <div class="row-md-6">
                                        <label class="form-label">رقم الهاتف</label>
                                        <input type="text" class="form-control" name="phoneNumber" id="phoneNumber" required
                                               value="@Model.PhoneNumber">
                                    </div>
                                    <div class="row-md-6">
                                        <label class="form-label">القسم / الفخذ</label>
                                        <select class="form-select" name="sectionId" id="sectionSelect">
                                            <option value="@Model.SectionId" selected>@Model.SectionName</option>
                                        </select>
                                    </div>
                                    <div class="row-md-6">
                                        <label class="form-label">تاريخ الميلاد</label>
                                        <input type="date" class="form-control" name="birthDate" id="birthDate"
                                               value="@Model.BirthDate.ToString("yyyy-MM-dd")">
                                    </div>
                                    <div class="row-md-6 mb-3">
                                        <label class="form-label">الجنس</label>
                                        <select class="form-select" name="GenderId" id="genderSelect">
                                            <option value="">اختر الجنس...</option>
                                            <option value="M" @(Model.Gender == 'M' ? "selected" : "")>ذكر</option>
                                            <option value="F" @(Model.Gender == 'F' ? "selected" : "")>انثى</option>
                                        </select>
                                    </div>
                                    <div class="col-12 text-end mt-4">
                                        <button type="submit" class="btn btn-danger px-4">حذف</button>
                                        <button type="button" class="btn btn-secondary"
                                                onclick="history.back()">إلغاء</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    @section Scripts {
        <script src="~/JS/apiService.js"></script>
        <script src="~/JS/Members/Delete.js"></script>
    }